NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/company_timesheet
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_WEB_URL=http://localhost:5173
CLIENT_MOBILE_URL=
COMPANY_TIMEZONE=Asia/Kolkata
# Optional. Comma-separated roles that may edit their own entries outside today/yesterday. Future dates stay locked.
TIMESHEET_ENTRY_WINDOW_OVERRIDE_ROLES=
BCRYPT_ROUNDS=12
TRUST_PROXY=0
LOG_LEVEL=info

# Used only by `npm run seed`. The API process does not require these.
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Admin
SEED_DEMO=false
SEED_DEMO_PASSWORD=
